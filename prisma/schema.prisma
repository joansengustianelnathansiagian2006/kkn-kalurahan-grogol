generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProgramKerja {
  id                 String   @id @default(cuid())
  namaProgram        String   @map("nama_program")
  kategori           String
  tanggalPelaksanaan DateTime @map("tanggal_pelaksanaan")
  lokasi             String

  latarBelakang      String   @db.Text @map("latar_belakang")
  tujuan             String   @db.Text
  pelaksanaan        String   @db.Text
  hasil              String   @db.Text
  manfaat            String   @db.Text
  
  fotoCover          String   @map("cover_url")
  dokumentasiFoto    String[] @map("dokumentasi_foto")
  dokumentasiVideo   String?  @map("dokumentasi_video")
  fileDigital        String?  @map("file_url") // <-- DIPERBAIKI (sebelumnya file_digital)
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("proker")
}

model Umkm {
  id            String   @id @default(cuid())
  logo          String?
  namaUmkm      String   @map("nama_umkm")
  deskripsi     String   @db.Text
  produk        String   @db.Text
  alamat        String
  lokasiMap     String?  @map("lokasi_map")
  nomorWhatsApp String   @map("nomor_whatsapp")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("umkm")
}

model PotensiDesa {
  id          String   @id @default(cuid())
  kategori    String   
  namaPotensi String   @map("nama_potensi")
  deskripsi   String   @db.Text
  fotoCover   String   @map("cover_url")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("potensidesa")
}

model Galeri {
  id          String   @id @default(cuid())
  tipe        String   // "Foto" | "Video"
  url         String?
  judul       String?
  kategori    String?  
  description String?  @db.Text // <-- DITAMBAHKAN
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("galeri")
}

model Artikel {
  id        String   @id @default(cuid())
  judul     String
  slug      String   @unique
  konten    String   @db.Text
  fotoCover String   @map("cover_url")
  penulis   String
  tanggal   DateTime @default(now())
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("artikel")
}

model DownloadCenter {
  id        String   @id @default(cuid())
  judul     String
  kategori  String   
  fileUrl   String   @map("file_url")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("downloadcenter")
}

model Kontak {
  id            String   @id @default(cuid())
  alamat        String
  googleMaps    String   @map("google_maps")
  email         String
  nomorWhatsApp String   @map("nomor_whatsapp")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("kontak")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nama      String
  role      String   @default("ADMIN")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin")
}