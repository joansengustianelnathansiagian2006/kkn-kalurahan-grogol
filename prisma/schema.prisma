generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProgramKerja {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama               String?   @map("nama")
  namaProgram        String?   @map("nama_program")
  slug               String?   @map("slug")
  kategori           String?   @map("kategori")
  tanggal            String?   @map("tanggal")
  tanggalPelaksanaan DateTime? @map("tanggal_pelaksanaan") @db.Timestamptz(6)
  lokasi             String?   @map("lokasi")
  fotoCover          String?   @map("cover_url")
  latarBelakang      String?   @map("latar_belakang")
  tujuan             String?   @map("tujuan")
  pelaksanaan        String?   @map("pelaksanaan")
  hasil              String?   @map("hasil")
  manfaat            String?   @map("manfaat")
  dokumentasiFoto    String[]  @map("dokumentasi_foto")
  dokumentasiVideo   String?   @map("dokumentasi_video")
  fileDigital        String?   @map("file_url")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("proker")
}

model Umkm {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logo             String?   @map("logo")
  nama             String?   @map("nama")
  namaUmkm         String?   @map("nama_umkm")
  deskripsi        String?   @map("deskripsi")
  produk           String?   @map("produk")
  alamat           String?   @map("alamat")
  lokasiMap        String?   @map("lokasi_map")
  nomorWhatsApp    String?   @map("nomor_whatsapp")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  logo_url         String?
  maps_url         String?
  no_hp            String?
  slug             String?
  foto_url         String?
  cover_url        String?
  gambar_url       String?
  description      String?
  google_maps      String?
  whatsapp         String?
  pemilik          String?
  kategori         String?
  dusun            String?
  padukuhan        String?
  kategori_usaha   String?
  foto             String?
  foto_produk      String?
  url_foto         String?
  deskripsi_produk String?

  @@map("umkm")
}

model PotensiDesa {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kategori    String?   @map("kategori")
  nama        String?   @map("nama")
  namaPotensi String?   @map("nama_potensi")
  deskripsi   String?   @map("deskripsi")
  fotoCover   String?   @map("cover_url")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  foto_url    String?
  gambar_url  String?

  @@map("potensidesa")
}

model Galeri {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipe         String?   @map("tipe")
  url          String?   @map("url")
  judul        String?   @map("judul")
  kategori     String?   @map("kategori")
  description  String?   @map("description")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  foto_url     String?
  video_url    String?
  deskripsi    String?
  image        String?
  title        String?
  category     String?
  media_url    String?
  url_media    String?
  youtube_url  String?
  link_youtube String?
  keterangan   String?
  type         String?

  @@map("galeri")
}

model Artikel {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul      String?   @map("judul")
  slug       String?   @unique @map("slug")
  konten     String?   @map("konten")
  fotoCover  String?   @map("cover_url")
  penulis    String?   @map("penulis")
  tanggal    DateTime? @default(now()) @map("tanggal") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  kategori   String?
  isi        String?
  foto_url   String?
  gambar_url String?

  @@map("artikel")
}

model DownloadCenter {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judul     String?   @map("judul")
  kategori  String?   @map("kategori")
  fileUrl   String?   @map("file_url")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  nama      String?
  url       String?
  title     String?
  category  String?
  file      String?

  @@map("downloadcenter")
}

model Kontak {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alamat          String?   @map("alamat")
  googleMaps      String?   @map("google_maps")
  email           String?   @map("email")
  nomorWhatsApp   String?   @map("nomor_whatsapp")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  maps_url        String?
  no_hp           String?
  whatsapp        String?
  telepon         String?
  phone           String?   @db.VarChar(50)
  jam_operasional String?   @db.VarChar(200)
  maps_embed_url  String?
  instagram       String?   @db.VarChar(255)
  facebook        String?   @db.VarChar(255)
  youtube         String?   @db.VarChar(255)

  @@map("kontak")
}

model Admin {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  username  String    @unique @map("username")
  password  String    @map("password")
  nama      String?   @map("nama")
  role      String?   @default("ADMIN") @map("role")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin")
}

