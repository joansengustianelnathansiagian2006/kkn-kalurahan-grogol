generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ProgramKerja {
  id                 String    @id @default(cuid())
  nama               String?   @map("nama")
  namaProgram        String?   @map("nama_program")
  slug               String?   @map("slug")
  kategori           String?   @map("kategori")
  tanggal            DateTime? @map("tanggal")
  tanggalPelaksanaan DateTime? @map("tanggal_pelaksanaan")
  lokasi             String?   @map("lokasi")

  latarBelakang      String?   @db.Text @map("latar_belakang")
  tujuan             String?   @db.Text @map("tujuan")
  pelaksanaan        String?   @db.Text @map("pelaksanaan")
  hasil              String?   @db.Text @map("hasil")
  manfaat            String?   @db.Text @map("manfaat")

  fotoCover          String?   @map("cover_url")
  dokumentasiFoto    String[]  @default([]) @map("dokumentasi_foto")
  dokumentasiVideo   String?   @map("dokumentasi_video")
  fileDigital        String?   @map("file_url")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("proker")
}

model Umkm {
  id            String   @id @default(cuid())
  logo          String?  @map("logo")
  nama          String?  @map("nama")
  namaUmkm      String?  @map("nama_umkm")
  deskripsi     String?  @db.Text @map("deskripsi")
  produk        String?  @db.Text @map("produk")
  alamat        String?  @map("alamat")
  lokasiMap     String?  @map("lokasi_map")
  nomorWhatsApp String?  @map("nomor_whatsapp")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("umkm")
}

model PotensiDesa {
  id          String   @id @default(cuid())
  kategori    String?  @map("kategori")
  nama        String?  @map("nama")
  namaPotensi String?  @map("nama_potensi")
  deskripsi   String?  @db.Text @map("deskripsi")
  fotoCover   String?  @map("cover_url")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("potensidesa")
}

model Galeri {
  id          String   @id @default(cuid())
  tipe        String?  @map("tipe")
  url         String?  @map("url")
  judul       String?  @map("judul")
  kategori    String?  @map("kategori")
  description String?  @db.Text @map("description")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("galeri")
}

model Artikel {
  id        String   @id @default(cuid())
  judul     String?  @map("judul")
  slug      String?  @unique @map("slug")
  konten    String?  @db.Text @map("konten")
  fotoCover String?  @map("cover_url")
  penulis   String?  @map("penulis")
  tanggal   DateTime @default(now()) @map("tanggal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("artikel")
}

model DownloadCenter {
  id        String   @id @default(cuid())
  judul     String?  @map("judul")
  kategori  String?  @map("kategori")
  fileUrl   String?  @map("file_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("downloadcenter")
}

model Kontak {
  id            String   @id @default(cuid())
  alamat        String?  @map("alamat")
  googleMaps    String?  @map("google_maps")
  email         String?  @map("email")
  nomorWhatsApp String?  @map("nomor_whatsapp")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("kontak")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique @map("username")
  password  String   @map("password")
  nama      String?  @map("nama")
  role      String   @default("ADMIN") @map("role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin")
}